---
// ArtisanAppraisalStudio.astro - Pure Tailwind CSS, Anti-AI Slop, Minimalist Dark/Light Studio
---

<section class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">

  <!-- Clean, Bold Hero Title (Anti-AI Slop: Direct and honest) -->
  <div class="text-center pt-2 sm:pt-4">
    <h1 id="i18n-hero-title" data-i18n="hero_title" class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-neutral-900 dark:text-neutral-100 uppercase select-none leading-none">
      KNOW YOUR CRAFT PRICE
    </h1>
  </div>

  <!-- Minimal Input Capsule (Tailwind CSS: Clean, responsive, icon-driven, drag & drop enabled) -->
  <div id="studio-input-capsule" class="relative bg-neutral-50 dark:bg-[#15171a] rounded-3xl border border-neutral-200 dark:border-neutral-800 p-4 sm:p-5 shadow-sm focus-within:border-blue-600 transition-all space-y-3">
    
    <!-- Drag and Drop Visual Overlay -->
    <div id="capsule-drop-overlay" class="hidden absolute inset-0 rounded-3xl bg-blue-50/90 dark:bg-blue-950/85 border-2 border-dashed border-blue-600 z-20 flex flex-col items-center justify-center pointer-events-none transition-all">
      <svg class="w-8 h-8 text-blue-600 mb-1 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      <span data-i18n="drop_photo_text" class="text-xs font-bold text-blue-600 dark:text-blue-400 tracking-wide">Drop craft photo here</span>
    </div>

    <!-- Attached Image Chip (Shown only when image is attached) -->
    <div id="image-chip-container" class="hidden flex items-center gap-2.5 p-1.5 bg-white dark:bg-[#1e2025] rounded-xl border border-neutral-200 dark:border-neutral-700 w-fit max-w-full">
      <img id="image-chip-preview" src="" alt="Craft" class="w-10 h-10 rounded-lg object-cover border border-neutral-200 dark:border-neutral-700" />
      <div class="flex-1 min-w-0 pr-2">
        <span id="image-chip-title" class="text-xs font-semibold text-neutral-900 dark:text-neutral-100 truncate block">Craft Attached</span>
        <span id="image-chip-status" class="text-[10px] text-emerald-500 font-medium block">Ready</span>
      </div>
      <button 
        type="button" 
        id="remove-chip-btn" 
        class="w-5 h-5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 flex items-center justify-center text-xs transition-colors cursor-pointer"
        title="Remove"
      >
        ✕
      </button>
    </div>

    <!-- Hidden File Input -->
    <input type="file" id="craft-file-input" accept="image/*" class="hidden" />

    <!-- Prompt / Speech Input -->
    <div class="relative">
      <textarea 
        id="studio-prompt-input" 
        data-i18n-placeholder="input_placeholder"
        rows="2" 
        class="w-full bg-transparent text-sm sm:text-base text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:outline-none resize-none leading-relaxed"
        placeholder="Describe days, material cost, or tap mic to speak in any language..."
      ></textarea>
    </div>

    <!-- Active Voice Wave Strip (Listening) -->
    <div id="audio-wave-strip" class="hidden flex items-center gap-1.5 py-1 text-xs text-blue-600 dark:text-blue-400">
      <span class="w-1 h-3 bg-blue-600 rounded-full animate-bounce"></span>
      <span class="w-1 h-5 bg-blue-600 rounded-full animate-bounce [animation-delay:150ms]"></span>
      <span class="w-1 h-2 bg-blue-600 rounded-full animate-bounce [animation-delay:300ms]"></span>
      <span class="w-1 h-4 bg-blue-600 rounded-full animate-bounce [animation-delay:75ms]"></span>
      <span id="listening-text" data-i18n="listening_text" class="font-mono text-xs ml-2">Listening... (Speak in any language)</span>
    </div>

    <!-- Voice Processing & Translation Indicator -->
    <div id="audio-processing-strip" class="hidden flex items-center gap-2 py-1 text-xs text-blue-600 dark:text-blue-400">
      <svg class="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span data-i18n="voice_processing_text" class="font-medium text-xs">Translating voice to English & extracting details...</span>
    </div>

    <!-- Voice Translation Success Notification -->
    <div id="audio-success-strip" class="hidden flex items-center gap-1.5 py-1 text-xs text-emerald-600 dark:text-emerald-400">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      <span data-i18n="voice_success_text" class="font-medium text-xs">Voice translated to English and loaded! Click "Calculate Price" below.</span>
    </div>

    <!-- Controls Row: Upload + Mic + Days + City + Cost + Calculate -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 pt-2 border-t border-neutral-200 dark:border-neutral-800/80">
      
      <!-- Inputs Strip -->
      <div class="flex flex-wrap items-center gap-2">
        
        <!-- Upload Icon Button -->
        <button 
          type="button" 
          id="trigger-upload-btn"
          class="w-9 h-9 rounded-full bg-white dark:bg-[#1e2025] hover:bg-neutral-100 dark:hover:bg-neutral-700 text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700 flex items-center justify-center transition-colors cursor-pointer"
          title="Attach or drop photo"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </button>

        <!-- Symmetrical Mic Icon Button -->
        <button 
          type="button" 
          id="trigger-mic-btn"
          class="relative w-9 h-9 rounded-full bg-white dark:bg-[#1e2025] hover:bg-neutral-100 dark:hover:bg-neutral-700 text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700 flex items-center justify-center transition-colors cursor-pointer"
          title="Speak in any language"
        >
          <svg id="mic-icon-svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" x2="12" y1="19" y2="22"/>
            <line x1="8" x2="16" y1="22" y2="22"/>
          </svg>
          <span id="mic-pulse" class="hidden absolute -inset-1 rounded-full border border-blue-600 animate-ping opacity-75"></span>
        </button>

        <!-- Working Days Input (Default 0 per user instruction) -->
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-[#1e2025] border border-neutral-200 dark:border-neutral-700 text-xs text-neutral-500 dark:text-neutral-400">
          <span data-i18n="days_label" class="font-medium text-[11px]">Days:</span>
          <input 
            type="number" 
            id="capsule-days-input" 
            value="0" 
            min="0" 
            max="90"
            class="w-10 bg-transparent text-neutral-900 dark:text-neutral-100 font-mono font-semibold text-xs focus:outline-none text-center" 
          />
        </div>

        <!-- Comprehensive Cities List (Over 35+ Major Indian Craft Clusters) -->
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-[#1e2025] border border-neutral-200 dark:border-neutral-700 text-xs text-neutral-500 dark:text-neutral-400">
          <span data-i18n="city_label" class="font-medium text-[11px]">City:</span>
          <select 
            id="capsule-city-select"
            class="bg-transparent text-neutral-900 dark:text-neutral-100 font-semibold text-xs focus:outline-none cursor-pointer pr-1 max-w-[150px] sm:max-w-none"
          >
            <optgroup label="Central & East India" class="bg-white dark:bg-[#1e2025] text-neutral-900 dark:text-neutral-100">
              <option value="Bastar_CG">Bastar (CG)</option>
              <option value="Kondagaon_CG">Kondagaon (CG)</option>
              <option value="Raipur_CG">Raipur (CG)</option>
              <option value="Bilaspur_CG">Bilaspur (CG)</option>
              <option value="Raigarh_CG">Raigarh (CG)</option>
              <option value="Champa_CG">Champa (CG)</option>
              <option value="Madhubani_BR">Madhubani (BR)</option>
              <option value="Bhagalpur_BR">Bhagalpur (BR)</option>
              <option value="Shantiniketan_WB">Shantiniketan (WB)</option>
              <option value="Bankura_WB">Bankura (WB)</option>
              <option value="Bishnupur_WB">Bishnupur (WB)</option>
              <option value="Murshidabad_WB">Murshidabad (WB)</option>
              <option value="Puri_OD">Puri / Raghurajpur (OD)</option>
              <option value="Cuttack_OD">Cuttack (OD)</option>
              <option value="Sambalpur_OD">Sambalpur (OD)</option>
            </optgroup>
            <optgroup label="North India" class="bg-white dark:bg-[#1e2025] text-neutral-900 dark:text-neutral-100">
              <option value="Varanasi_UP">Varanasi (UP)</option>
              <option value="Lucknow_UP">Lucknow (UP)</option>
              <option value="Bhadohi_UP">Bhadohi (UP)</option>
              <option value="Moradabad_UP">Moradabad (UP)</option>
              <option value="Saharanpur_UP">Saharanpur (UP)</option>
              <option value="Firozabad_UP">Firozabad (UP)</option>
              <option value="Agra_UP">Agra (UP)</option>
              <option value="Khurja_UP">Khurja (UP)</option>
              <option value="Jaipur_RJ">Jaipur (RJ)</option>
              <option value="Jodhpur_RJ">Jodhpur (RJ)</option>
              <option value="Udaipur_RJ">Udaipur (RJ)</option>
              <option value="Barmer_RJ">Barmer (RJ)</option>
              <option value="Srinagar_JK">Srinagar (JK)</option>
              <option value="Anantnag_JK">Anantnag (JK)</option>
              <option value="Kullu_HP">Kullu (HP)</option>
            </optgroup>
            <optgroup label="West & South India" class="bg-white dark:bg-[#1e2025] text-neutral-900 dark:text-neutral-100">
              <option value="Kutch_GJ">Kutch / Bhuj (GJ)</option>
              <option value="Patan_GJ">Patan (GJ)</option>
              <option value="Surat_GJ">Surat (GJ)</option>
              <option value="Maheshwar_MP">Maheshwar / Indore (MP)</option>
              <option value="Chanderi_MP">Chanderi (MP)</option>
              <option value="Bhopal_MP">Bhopal (MP)</option>
              <option value="Kolhapur_MH">Kolhapur (MH)</option>
              <option value="Paithan_MH">Paithan (MH)</option>
              <option value="Kanchipuram_TN">Kanchipuram (TN)</option>
              <option value="Thanjavur_TN">Thanjavur (TN)</option>
              <option value="Madurai_TN">Madurai (TN)</option>
              <option value="Mysore_KA">Mysore (KA)</option>
              <option value="Channapatna_KA">Channapatna (KA)</option>
              <option value="Bidar_KA">Bidar (KA)</option>
              <option value="Hyderabad_TS">Hyderabad (TS)</option>
              <option value="Warangal_TS">Warangal (TS)</option>
              <option value="Pochampally_TS">Pochampally (TS)</option>
            </optgroup>
            <optgroup label="Other" class="bg-white dark:bg-[#1e2025] text-neutral-900 dark:text-neutral-100">
              <option value="Rural_Cluster">General Rural Cluster</option>
            </optgroup>
          </select>
        </div>

        <!-- Material Cost Input (Default 0 per user instruction) -->
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-[#1e2025] border border-neutral-200 dark:border-neutral-700 text-xs text-neutral-500 dark:text-neutral-400">
          <span data-i18n="cost_label" class="font-medium text-[11px]">Cost:</span>
          <span class="font-mono text-neutral-400">₹</span>
          <input 
            type="number" 
            id="capsule-cost-input" 
            value="0" 
            min="0" 
            max="50000"
            class="w-14 bg-transparent text-neutral-900 dark:text-neutral-100 font-mono font-semibold text-xs focus:outline-none" 
          />
        </div>

      </div>

      <!-- Calculate Price Button -->
      <button 
        type="button" 
        id="estimate-price-btn"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold transition-all active:scale-95 cursor-pointer ml-auto"
      >
        <span data-i18n="calc_btn">Calculate Price</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>

    </div>

  </div>

  <!-- Fair Valuation Output Section (Zeroed by default per user instruction) -->
  <div id="valuation-result-card" class="bg-white dark:bg-[#15171a] rounded-3xl border border-neutral-200 dark:border-neutral-800 p-6 sm:p-8 space-y-6 shadow-sm">
    
    <!-- Header: Craft Identity + GI Badge -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-neutral-100 dark:border-neutral-800 pb-4">
      <div>
        <h2 id="eval-craft-name" class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">
          No Craft Selected
        </h2>
        <span id="eval-location-text" class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 block">
          Set working days and material cost or speak to calculate
        </span>
      </div>

      <div class="flex items-center gap-2">
        <span id="eval-gi-badge" class="px-3 py-1 rounded-full text-xs font-semibold bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700">
          Unappraised
        </span>
        <span data-i18n="producer_rate_badge" class="px-3 py-1 rounded-full text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700">
          Direct Producer Rate
        </span>
      </div>
    </div>

    <!-- Main Fair Price Metric Card -->
    <div class="p-6 rounded-2xl bg-neutral-50 dark:bg-[#1b1d22] border border-neutral-200 dark:border-neutral-700/80 flex flex-col sm:flex-row sm:items-baseline justify-between gap-5">
      <div>
        <div data-i18n="fair_price_title" class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wider font-semibold">Fair Direct Price</div>
        <div class="text-4xl sm:text-5xl font-extrabold text-neutral-900 dark:text-neutral-100 font-mono tracking-tight mt-1.5" id="eval-fair-price">
          ₹0
        </div>
        <div class="text-xs text-emerald-600 dark:text-emerald-400 mt-1.5 font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span data-i18n="fair_share_sub">100% direct artisan share · Zero intermediary cut</span>
        </div>
      </div>

      <div class="sm:text-right space-y-1 sm:border-l sm:border-neutral-200 sm:dark:border-neutral-800 sm:pl-6">
        <div data-i18n="conf_interval_title" class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wider font-semibold">95% Confidence Interval</div>
        <div class="text-base sm:text-lg font-bold text-neutral-800 dark:text-neutral-200 font-mono" id="eval-fair-range">
          ₹0 — ₹0
        </div>
        <div data-i18n="index_sub" class="text-[11px] text-neutral-400 dark:text-neutral-500">
          Cluster wage & material index
        </div>
      </div>
    </div>

    <!-- Middleman vs Direct Price vs Retail Comparison -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      
      <!-- Middleman Exploitation -->
      <div class="p-4 rounded-xl bg-red-500/5 border border-red-500/20 text-center">
        <div data-i18n="middleman_title" class="text-xs font-semibold text-red-600 dark:text-red-400">Middleman Offer</div>
        <div class="text-xl sm:text-2xl font-bold text-red-600 dark:text-red-400 mt-1 font-mono" id="eval-middleman-price">₹0</div>
        <div id="eval-middleman-sub" class="text-[11px] text-red-500 font-medium mt-1">0% below fair value</div>
      </div>

      <!-- Fair Price (Recommended) -->
      <div class="p-4 rounded-xl bg-blue-500/5 border-2 border-blue-600 dark:border-blue-500 text-center">
        <div data-i18n="fair_direct_title" class="text-xs font-semibold text-blue-600 dark:text-blue-400">Fair Direct Price</div>
        <div class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1 font-mono" id="eval-fair-price-comp">₹0</div>
        <div data-i18n="recommended_sub" class="text-[11px] text-blue-600 dark:text-blue-400 font-medium mt-1">Recommended artisan rate</div>
      </div>

      <!-- Urban Retail MRP -->
      <div class="p-4 rounded-xl bg-neutral-50 dark:bg-[#1b1d22] border border-neutral-200 dark:border-neutral-700/80 text-center">
        <div data-i18n="showroom_title" class="text-xs font-semibold text-neutral-600 dark:text-neutral-400">Showroom / Gallery MRP</div>
        <div class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-1 font-mono" id="eval-showroom-price">₹0</div>
        <div id="eval-showroom-sub" class="text-[11px] text-neutral-500 font-medium mt-1">City store markup (+0%)</div>
      </div>

    </div>

    <!-- Cost Breakdown -->
    <div class="space-y-2">
      <div data-i18n="breakdown_title" class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Cost Breakdown</div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
        
        <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-[#1b1d22] border border-neutral-200 dark:border-neutral-800">
          <div data-i18n="labor_title" class="text-neutral-500 dark:text-neutral-400 text-[11px]">Labor Compensation</div>
          <div class="text-base font-bold text-neutral-900 dark:text-neutral-100 font-mono mt-1" id="breakdown-labor">₹0</div>
          <div data-i18n="labor_sub" class="text-[10px] text-neutral-400 mt-0.5">Days × skilled wage</div>
        </div>

        <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-[#1b1d22] border border-neutral-200 dark:border-neutral-800">
          <div data-i18n="materials_title" class="text-neutral-500 dark:text-neutral-400 text-[11px]">Material & Wastage</div>
          <div class="text-base font-bold text-neutral-900 dark:text-neutral-100 font-mono mt-1" id="breakdown-materials">₹0</div>
          <div data-i18n="materials_sub" class="text-[10px] text-neutral-400 mt-0.5">Raw cost + 15% wastage</div>
        </div>

        <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-[#1b1d22] border border-neutral-200 dark:border-neutral-800">
          <div data-i18n="gi_title" class="text-neutral-500 dark:text-neutral-400 text-[11px]">GI Heritage Premium</div>
          <div class="text-base font-bold text-blue-600 dark:text-blue-400 font-mono mt-1" id="breakdown-gi">₹0</div>
          <div data-i18n="gi_sub" class="text-[10px] text-blue-500/80 mt-0.5">Cluster legal premium</div>
        </div>

        <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-[#1b1d22] border border-neutral-200 dark:border-neutral-800">
          <div data-i18n="profit_title" class="text-neutral-500 dark:text-neutral-400 text-[11px]">Artisan Margin (25%)</div>
          <div class="text-base font-bold text-emerald-600 dark:text-emerald-400 font-mono mt-1" id="breakdown-profit">₹0</div>
          <div data-i18n="profit_sub" class="text-[10px] text-emerald-500/80 mt-0.5">Fair trade surplus</div>
        </div>

      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
      <button 
        type="button" 
        id="save-to-database-btn"
        class="w-full sm:flex-1 py-3 px-5 rounded-full bg-neutral-900 hover:bg-neutral-800 dark:bg-neutral-100 dark:hover:bg-white text-white dark:text-neutral-900 font-semibold text-xs flex items-center justify-center gap-2 transition-all active:scale-98 cursor-pointer shadow-sm"
      >
        <svg class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17 21 17 13 7 13 7 21"/>
          <polyline points="7 3 7 8 15 8"/>
        </svg>
        <span data-i18n="save_db_btn">Save to Database</span>
      </button>

      <button 
        type="button" 
        id="whatsapp-invoice-btn"
        class="w-full sm:flex-1 py-3 px-5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs flex items-center justify-center gap-2 transition-all active:scale-98 cursor-pointer shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span data-i18n="whatsapp_btn">Send on WhatsApp</span>
      </button>
    </div>

    <div id="save-status-msg" class="hidden p-2.5 rounded-full text-xs font-semibold text-center bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"></div>

  </div>

  <!-- Real-Time Recent Appraisals Slider (NO PHOTOS per user instruction) -->
  <section id="recent-appraisals-section" class="space-y-4 pt-2">
    
    <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 pb-3">
      <h3 data-i18n="recent_title" class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">
        Recent Database Appraisals
      </h3>
      
      <!-- Slider Pagination Controls -->
      <div class="flex items-center gap-2">
