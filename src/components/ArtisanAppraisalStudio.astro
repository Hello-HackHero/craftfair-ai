};

    // Speech Rec Language Tags
    const LANG_SPEECH_MAP = {
      en: 'en-IN',
      hi: 'hi-IN',
      bn: 'bn-IN',
      or: 'or-IN',
      te: 'te-IN',
      ta: 'ta-IN',
      kn: 'kn-IN',
      mr: 'mr-IN',
      gu: 'gu-IN',
      pa: 'pa-IN',
      ml: 'ml-IN',
      ur: 'ur-IN',
      as: 'as-IN'
    };

    let currentLang = localStorage.getItem('craftfair_lang') || 'en';

    function getI18n(key) {
      const dict = CRAFTFAIR_I18N[currentLang] || CRAFTFAIR_I18N['en'];
      return dict[key] || (CRAFTFAIR_I18N['en'] && CRAFTFAIR_I18N['en'][key]) || '';
    }

    function applyLanguage(lang) {
      currentLang = lang || 'en';
      const dict = CRAFTFAIR_I18N[currentLang] || CRAFTFAIR_I18N['en'];

      // 1. Static text elements
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) el.textContent = dict[key];
      });

      // 2. Input placeholders
      document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (dict[key]) el.setAttribute('placeholder', dict[key]);
      });

      // 3. Dynamic evaluation labels
      if (currentPrediction) {
        const data = currentPrediction;
        if (evalCraftName) evalCraftName.textContent = currentTitle || currentCategory || dict['no_craft_selected'];
        
        const cleanCity = currentRegion.replace(/_/g, ' ');
        const dailyRate = currentDays > 0 ? Math.round(data.labour_compensation / (currentDays * (1 + (currentComplexity - 1) * 0.065))) : 400;
        const laborTpl = dict['labor_summary'] || '{city} · Labor: {days} days @ ₹{rate}/day';
        if (evalLocationText) {
          evalLocationText.textContent = laborTpl
            .replace('{city}', cleanCity)
            .replace('{days}', currentDays)
            .replace('{rate}', dailyRate);
        }

        if (evalMiddlemanSub) {
          const pct = data.fair_price > 0 ? Math.round(((data.fair_price - data.middleman_exploitation_price) / data.fair_price) * 100) : 0;
          const mmTpl = dict['below_fair_val'] || '{pct}% below fair value';
          evalMiddlemanSub.textContent = mmTpl.replace('{pct}', pct);
        }

        if (evalShowroomSub) {
          const pct = data.fair_price > 0 ? Math.round(((data.urban_showroom_mrp - data.fair_price) / data.fair_price) * 100) : 0;
          const srTpl = dict['city_markup'] || 'City store markup (+{pct}%)';
          evalShowroomSub.textContent = srTpl.replace('{pct}', pct);
        }

        if (evalGiBadge) {
          evalGiBadge.textContent = data.metrics.gi_tag_eligible 
            ? (dict['gi_tag_protected'] || 'GI Tag Protected') 
            : (dict['standard_craft'] || 'Standard Craft');
        }
      } else {
        // Zero-default state: completely update all dynamic labels in newly selected language
        if (evalCraftName) evalCraftName.textContent = currentTitle || currentCategory || dict['no_craft_selected'];
        if (evalLocationText) evalLocationText.textContent = dict['set_days_sub'];
        if (evalGiBadge) evalGiBadge.textContent = dict['unappraised'];
        if (evalMiddlemanSub) evalMiddlemanSub.textContent = dict['middleman_sub'];
        if (evalShowroomSub) evalShowroomSub.textContent = dict['showroom_sub'];
      }
    }

    // Elements
