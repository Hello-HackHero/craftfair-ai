    if (capsuleCostInput) {
      capsuleCostInput.addEventListener('input', (e) => {
        currentCost = parseInt(e.target.value, 10) || 0;
      });
    }

    // Shared Craft Image Processor (Used for both File Upload and Drag-and-Drop)
    async function handleCraftImageFile(file) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async (event) => {
        const rawDataUrl = event.target.result;
        imageChipTitle.textContent = file.name || 'Craft Photo';
        imageChipStatus.textContent = 'Vision AI analyzing...';
        imageChipContainer.classList.remove('hidden');

        // Client-side image resize to 512px max to ensure fast vision AI response (<50KB)
        const img = new Image();
        img.onload = async () => {
          const maxDim = 512;
          let w = img.width;
          let h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) {
              h = Math.round((h * maxDim) / w);
              w = maxDim;
            } else {
              w = Math.round((w * maxDim) / h);
              h = maxDim;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          const compressedBase64 = canvas.toDataURL('image/jpeg', 0.85);

          currentPhotoBase64 = compressedBase64;
          imageChipPreview.src = compressedBase64;

          // Sample canvas pixel color tone for robust craft prior
          let visualTone = 'unknown';
          try {
            const imgData = ctx.getImageData(0, 0, w, h);
            const d = imgData.data;
            let totalR = 0, totalG = 0, totalB = 0, count = 0;
            const step = Math.max(1, Math.floor(d.length / (4 * 1000)));
            for (let i = 0; i < d.length; i += step * 4) {
              totalR += d[i];
              totalG += d[i+1];
              totalB += d[i+2];
              count++;
            }
            const avgR = totalR / count;
            const avgG = totalG / count;
            const avgB = totalB / count;

            if (avgR > avgB + 20 && avgR > avgG + 10 && avgR > 85) {
              visualTone = 'terracotta_pottery';
            } else if (avgR < 75 && avgG < 75 && avgB < 75) {
              visualTone = 'wrought_iron';
            } else if (avgR > 130 && avgG > 110 && avgB < 100) {
              visualTone = (avgR - avgB > 50) ? 'dhokra_metal' : 'bamboo_cane';
            }
          } catch (e) {
            console.warn('Tone detection err:', e);
          }

          try {
            const res = await fetch('/api/classify-craft', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ 
                image: currentPhotoBase64, 
                fileName: file.name,
                promptText: promptInput ? promptInput.value : '',
                visualTone: visualTone
              })
            });

            if (res.ok) {
              const data = await res.json();
              currentCategory = data.craft_category || 'Terracotta & Pottery';
              currentTitle = data.suggested_title || currentCategory;
              currentDays = data.estimated_labour_days || 4;
              currentCost = data.estimated_material_cost || 250;
              currentComplexity = data.complexity_score || 7;
              if (data.gi_region && capsuleCitySelect) {
                const match = Array.from(capsuleCitySelect.options).find(opt => opt.value.toLowerCase().includes(data.gi_region.toLowerCase()));
                if (match) currentRegion = match.value;
              }

              if (capsuleDaysInput) capsuleDaysInput.value = currentDays;
              if (capsuleCostInput) capsuleCostInput.value = currentCost;
              if (capsuleCitySelect) capsuleCitySelect.value = currentRegion;

              imageChipStatus.textContent = currentTitle;
              if (evalCraftName) evalCraftName.textContent = currentTitle;
              if (promptInput && !promptInput.value.includes(currentTitle)) {
                promptInput.value = `${currentTitle} (${currentDays} days, ₹${currentCost} cost)`;
              }
              // Do NOT auto-compute price per user instruction; user clicks "Calculate Price"
            } else {
              imageChipStatus.textContent = 'Craft attached';
            }
          } catch (err) {
            console.warn('Vision analysis error:', err);
            imageChipStatus.textContent = currentTitle || 'Attached';
          }
        };
        img.src = rawDataUrl;
      };
      reader.readAsDataURL(file);
    }

    // Upload Trigger Button
    if (triggerUploadBtn && fileInput) {
      triggerUploadBtn.addEventListener('click', () => fileInput.click());
    }

    if (fileInput) {
      fileInput.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (file) handleCraftImageFile(file);
      });
    }

    // Drag and Drop Craft Photo directly onto Capsule
    const inputCapsule = document.getElementById('studio-input-capsule');
    const dropOverlay = document.getElementById('capsule-drop-overlay');

    if (inputCapsule && dropOverlay) {
      ['dragenter', 'dragover'].forEach(eventName => {
        inputCapsule.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropOverlay.classList.remove('hidden');
        });
      });

      ['dragleave', 'dragend'].forEach(eventName => {
        inputCapsule.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (!inputCapsule.contains(e.relatedTarget)) {
            dropOverlay.classList.add('hidden');
          }
        });
      });

      inputCapsule.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropOverlay.classList.add('hidden');
        const file = e.dataTransfer?.files?.[0];
        if (file && file.type.startsWith('image/')) {
          handleCraftImageFile(file);
        }
      });
    }

    if (removeChipBtn) {
      removeChipBtn.addEventListener('click', () => {
        fileInput.value = '';
        currentPhotoBase64 = '';
        imageChipPreview.src = '';
        imageChipContainer.classList.add('hidden');
      });
    }

    // Voice Capture & Translation Feedback
    const SpeechRecClass = window.SpeechRecognition || window.webkitSpeechRecognition;
    const audioProcessingStrip = document.getElementById('audio-processing-strip');
    const audioSuccessStrip = document.getElementById('audio-success-strip');

    if (triggerMicBtn) {
      triggerMicBtn.addEventListener('click', async () => {
        if (!isRecording) {
          isRecording = true;
          triggerMicBtn.classList.add('text-blue-600', 'border-blue-600');
          micPulse.classList.remove('hidden');
          audioWaveStrip.classList.remove('hidden');
          if (audioProcessingStrip) audioProcessingStrip.classList.add('hidden');
          if (audioSuccessStrip) audioSuccessStrip.classList.add('hidden');

          if (SpeechRecClass) {
            try {
              speechRecognition = new SpeechRecClass();
              speechRecognition.continuous = true;
              speechRecognition.interimResults = true;
              speechRecognition.lang = LANG_SPEECH_MAP[currentLang] || 'hi-IN';

              speechRecognition.onresult = (evt) => {
                let liveText = '';
                for (let i = evt.resultIndex; i < evt.results.length; ++i) {
                  liveText += evt.results[i][0].transcript;
                }
                if (liveText.trim()) {
                  promptInput.value = liveText;
                }
              };
              speechRecognition.start();
            } catch (e) {
              console.warn('SpeechRec err:', e);
            }
          }

          if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            try {
              const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
              mediaRecorder = new MediaRecorder(stream);
              recordedChunks = [];
              mediaRecorder.ondataavailable = (ev) => {
                if (ev.data.size > 0) recordedChunks.push(ev.data);
              };
              mediaRecorder.onstop = async () => {
                const blob = new Blob(recordedChunks, { type: 'audio/webm' });
                if (promptInput.value && promptInput.value.length > 2) {
                  translateAndExtract(promptInput.value);
                } else {
                  if (audioProcessingStrip) audioProcessingStrip.classList.remove('hidden');
                  try {
                    const transRes = await fetch('/api/voice-transcribe', {
                      method: 'POST',
                      headers: { 'Content-Type': 'audio/webm' },
                      body: blob
                    });
                    if (transRes.ok) {
                      const transData = await transRes.json();
                      const eng = transData.english_translation || transData.transcription;
                      if (eng) {
                        promptInput.value = eng;
                        applyExtractedEntities(transData.extracted_entities);
                        if (audioSuccessStrip) {
                          audioSuccessStrip.classList.remove('hidden');
                          setTimeout(() => audioSuccessStrip.classList.add('hidden'), 4000);
                        }
                      }
                    }
                  } catch (wErr) {
                    console.warn('Whisper err:', wErr);
                  } finally {
                    if (audioProcessingStrip) audioProcessingStrip.classList.add('hidden');
                  }
                }
              };
              mediaRecorder.start();
            } catch (mErr) {
              console.warn('Mic err:', mErr);
            }
          }
        } else {
          isRecording = false;
          triggerMicBtn.classList.remove('text-blue-600', 'border-blue-600');
          micPulse.classList.add('hidden');
          audioWaveStrip.classList.add('hidden');

          if (speechRecognition) {
            try { speechRecognition.stop(); } catch (_) {}
          }
          if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            try { mediaRecorder.stop(); } catch (_) {}
          }

          if (promptInput.value && promptInput.value.trim().length > 1) {
            translateAndExtract(promptInput.value);
          }
        }
      });
    }

    async function translateAndExtract(text) {
      if (!text || !text.trim()) {
        if (audioProcessingStrip) audioProcessingStrip.classList.add('hidden');
        return;
      }
      if (audioProcessingStrip) audioProcessingStrip.classList.remove('hidden');
      if (audioSuccessStrip) audioSuccessStrip.classList.add('hidden');
      if (estimateBtn) estimateBtn.classList.add('opacity-75');

      try {
        const res = await fetch('/api/voice-transcribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ transcript: text })
        });
        if (res.ok) {
          const data = await res.json();
          if (data.english_translation) {
            promptInput.value = data.english_translation;
          }
          applyExtractedEntities(data.extracted_entities);
          if (audioSuccessStrip) {
            audioSuccessStrip.classList.remove('hidden');
            setTimeout(() => {
              audioSuccessStrip.classList.add('hidden');
            }, 4000);
          }
        }
      } catch (err) {
        console.warn('Translation err:', err);
      } finally {
        if (audioProcessingStrip) audioProcessingStrip.classList.add('hidden');
        if (estimateBtn) estimateBtn.classList.remove('opacity-75');
      }
    }

    function applyExtractedEntities(ent) {
      if (!ent) return;
      if (ent.craft_category) {
        // If image is attached, preserve the photo-detected title unless speech explicitly names another craft
        if (!currentPhotoBase64) {
          currentCategory = ent.craft_category;
          currentTitle = ent.suggested_title || ent.craft_category;
          if (evalCraftName) evalCraftName.textContent = currentTitle;
        }
      }
      if (ent.labour_days && ent.labour_days > 0) {
        currentDays = ent.labour_days;
        if (capsuleDaysInput) capsuleDaysInput.value = currentDays;
      }
      if (ent.raw_material_cost && ent.raw_material_cost > 0) {
        currentCost = ent.raw_material_cost;
        if (capsuleCostInput) capsuleCostInput.value = currentCost;
      }
      if (ent.region) {
        currentRegion = ent.region;
        if (capsuleCitySelect) capsuleCitySelect.value = currentRegion;
      }
      // Note: Do NOT auto-compute price; wait for user to click "Calculate Price"
    }

    // Compute Price
    async function computeFairPrice() {
      // If values are zero, show zero state per user instruction
      if (currentDays <= 0 && currentCost <= 0) {
        resetToZero();
        return;
      }

      if (!currentCategory) {
        currentCategory = 'Dhokra Metal Craft';
      }

      const payload = {
        craft_category: currentCategory,
        region: currentRegion,
        labour_days: currentDays,
        raw_material_cost: currentCost,
        complexity_score: currentComplexity,
        season_multiplier: 1.0
      };

      try {
        const res = await fetch('/api/predict-price', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          const data = await res.json();
          currentPrediction = data;

          if (evalCraftName) evalCraftName.textContent = currentTitle || currentCategory;
          const dict = CRAFTFAIR_I18N[currentLang] || CRAFTFAIR_I18N['en'];
          const cleanCity = currentRegion.replace(/_/g, ' ');
          const dailyRate = currentDays > 0 ? Math.round(data.labour_compensation / (currentDays * (1 + (currentComplexity - 1) * 0.065))) : 400;
          const laborTpl = dict['labor_summary'] || '{city} · Labor: {days} days @ ₹{rate}/day';
          if (evalLocationText) {
            evalLocationText.textContent = laborTpl
              .replace('{city}', cleanCity)
              .replace('{days}', currentDays)
              .replace('{rate}', dailyRate);
          }

          if (evalFairPrice) evalFairPrice.textContent = `₹${data.fair_price.toLocaleString('en-IN')}`;
          if (evalFairRange) evalFairRange.textContent = `₹${data.price_min_bound.toLocaleString('en-IN')} — ₹${data.price_max_bound.toLocaleString('en-IN')}`;
          if (evalFairPriceComp) evalFairPriceComp.textContent = `₹${data.fair_price.toLocaleString('en-IN')}`;
          if (evalMiddlemanPrice) evalMiddlemanPrice.textContent = `₹${data.middleman_exploitation_price.toLocaleString('en-IN')}`;
          if (evalMiddlemanSub) {
            const pct = data.fair_price > 0 ? Math.round(((data.fair_price - data.middleman_exploitation_price) / data.fair_price) * 100) : 0;
            const mmTpl = dict['below_fair_val'] || '{pct}% below fair value';
            evalMiddlemanSub.textContent = mmTpl.replace('{pct}', pct);
          }
          if (evalShowroomPrice) evalShowroomPrice.textContent = `₹${data.urban_showroom_mrp.toLocaleString('en-IN')}`;
          if (evalShowroomSub) {
            const pct = data.fair_price > 0 ? Math.round(((data.urban_showroom_mrp - data.fair_price) / data.fair_price) * 100) : 0;
            const srTpl = dict['city_markup'] || 'City store markup (+{pct}%)';
            evalShowroomSub.textContent = srTpl.replace('{pct}', pct);
          }

          if (evalGiBadge) {
            evalGiBadge.textContent = data.metrics.gi_tag_eligible 
              ? (dict['gi_tag_protected'] || 'GI Tag Protected') 
              : (dict['standard_craft'] || 'Standard Craft');
            if (data.metrics.gi_tag_eligible) {
              evalGiBadge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
            } else {
              evalGiBadge.className = 'px-3 py-1 rounded-full text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700';
            }
          }
          if (breakdownLabor) breakdownLabor.textContent = `₹${data.labour_compensation.toLocaleString('en-IN')}`;
          if (breakdownMaterials) breakdownMaterials.textContent = `₹${data.raw_material_with_wastage.toLocaleString('en-IN')}`;
          if (breakdownGi) breakdownGi.textContent = `+₹${data.gi_heritage_premium.toLocaleString('en-IN')}`;
          if (breakdownProfit) breakdownProfit.textContent = `+₹${data.artisan_profit_margin.toLocaleString('en-IN')}`;

          if (evalGiBadge) {
            evalGiBadge.textContent = data.metrics.gi_tag_eligible ? 'GI Tag Protected' : 'Standard Craft';
            if (data.metrics.gi_tag_eligible) {
              evalGiBadge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
            } else {
              evalGiBadge.className = 'px-3 py-1 rounded-full text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700';
            }
          }
        }
      } catch (err) {
        console.warn('Pricing calculation error:', err);
      }
    }

    if (promptInput) {
      promptInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (promptInput.value && promptInput.value.trim().length > 2) {
            translateAndExtract(promptInput.value);
          } else {
            computeFairPrice();
          }
        }
      });
    }

    if (estimateBtn) {
      estimateBtn.addEventListener('click', () => {
        if (promptInput && promptInput.value && promptInput.value.trim().length > 2) {
          translateAndExtract(promptInput.value);
        } else {
          if (currentDays === 0 && currentCost === 0) {
            // If artisan hasn't set days/cost, set reasonable starter values
            currentDays = 5;
            currentCost = 400;
            if (capsuleDaysInput) capsuleDaysInput.value = 5;
            if (capsuleCostInput) capsuleCostInput.value = 400;
          }
          computeFairPrice();
        }
      });
    }

    // Save to Database
    if (saveDbBtn) {
      saveDbBtn.addEventListener('click', async () => {
        if (!currentPrediction) await computeFairPrice();
        if (!currentPrediction || currentPrediction.fair_price === 0) return;

        saveDbBtn.disabled = true;
        saveDbBtn.classList.add('opacity-70');

        const listingItem = {
          title: `Handcrafted ${currentCategory || 'Craft Item'}`,
          category: currentCategory || 'Dhokra Metal Craft',
          craft_region: currentRegion,
          labour_days: currentDays,
          raw_cost: currentCost,
          fair_price: currentPrediction.fair_price,
          middleman_price: currentPrediction.middleman_exploitation_price,
          image_url: currentPhotoBase64 || 'https://images.unsplash.com/photo-1606744888344-493238955de0?auto=format&fit=crop&w=400&q=80',
          complexity_score: currentComplexity,
          gi_tag: currentPrediction.metrics.gi_tag_eligible,
          created_at: new Date().toISOString()
        };

        try {
          const res = await fetch('/api/catalog', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(listingItem)
          });

          if (res.ok) {
            saveStatusMsg.textContent = getI18n('saved_success') || '✓ Saved to database';
            saveStatusMsg.classList.remove('hidden');
            setTimeout(() => saveStatusMsg.classList.add('hidden'), 3000);
            fetchRecentAppraisals();
          }
        } catch (err) {
          console.warn('Save error:', err);
        } finally {
          saveDbBtn.disabled = false;
          saveDbBtn.classList.remove('opacity-70');
        }
      });
    }

    // WhatsApp Invoice
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', () => {
        const price = currentPrediction ? currentPrediction.fair_price : 0;
        const msg = 
`*CraftFair AI Fair Price Quote*
Craft: ${currentCategory || 'Artisan Craft'}
City: ${currentRegion.replace(/_/g, ' ')}
Labor: ${currentDays} Days
Artisan Fair Price: ₹${price.toLocaleString('en-IN')}

Direct artisan rate based on cluster wage and materials.`;

        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`, '_blank');
      });
    }

    // Slider Pagination
    async function fetchRecentAppraisals() {
      try {
        const res = await fetch('/api/catalog');
        if (res.ok) {
          databaseRecords = await res.json();
          currentSlideIndex = 0;
          renderSliderPage();
        }
      } catch (err) {
        console.warn('Fetch appraisals error:', err);
      }
    }

    function renderSliderPage() {
      if (!tableBody) return;
      if (!databaseRecords || databaseRecords.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" class="py-6 text-center text-neutral-400">
              No saved records yet.
            </td>
          </tr>
        `;
        if (sliderPageIndicator) sliderPageIndicator.textContent = '0 Records';
        if (sliderPrevBtn) sliderPrevBtn.disabled = true;
        if (sliderNextBtn) sliderNextBtn.disabled = true;
        return;
      }

      const totalPages = Math.ceil(databaseRecords.length / ITEMS_PER_SLIDE);
      if (currentSlideIndex >= totalPages) currentSlideIndex = totalPages - 1;
      if (currentSlideIndex < 0) currentSlideIndex = 0;

      const start = currentSlideIndex * ITEMS_PER_SLIDE;
      const end = Math.min(start + ITEMS_PER_SLIDE, databaseRecords.length);
      const visibleItems = databaseRecords.slice(start, end);

      if (sliderPageIndicator) {
        sliderPageIndicator.textContent = `${start + 1}–${end} of ${databaseRecords.length}`;
      }
      if (sliderPrevBtn) sliderPrevBtn.disabled = currentSlideIndex === 0;
      if (sliderNextBtn) sliderNextBtn.disabled = currentSlideIndex >= totalPages - 1;

      tableBody.innerHTML = visibleItems.map((it) => {
        const title = it.title || it.title_en || 'Handcrafted Item';
        const category = it.category || it.craft_category || 'Craft';
        const region = (it.craft_region || it.region || 'Bastar').replace(/_/g, ' ');
        const days = it.labour_days || 0;
        const cost = it.raw_cost || it.raw_material_cost || 0;
        const fairPrice = it.fair_price || 0;
        const middleman = it.middleman_price || Math.round(fairPrice * 0.36);
        const timeAgo = it.created_at ? new Date(it.created_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) : 'Saved';

        return `
          <tr class="hover:bg-neutral-50 dark:hover:bg-[#1a1c22] transition-colors">
            <td class="py-3 px-4">
              <div class="font-semibold text-neutral-900 dark:text-neutral-100 line-clamp-1">${title}</div>
              <div class="text-[11px] text-neutral-500">${category}</div>
            </td>
            <td class="py-3 px-4 font-mono text-[11px] text-neutral-500">${region}</td>
            <td class="py-3 px-4 font-mono text-[11px] text-neutral-900 dark:text-neutral-100">${days}d</td>
            <td class="py-3 px-4 font-mono text-[11px] text-neutral-500">₹${cost}</td>
            <td class="py-3 px-4 font-mono font-bold text-sm text-emerald-600 dark:text-emerald-400">₹${Number(fairPrice).toLocaleString('en-IN')}</td>
            <td class="py-3 px-4 font-mono text-xs text-red-500 line-through">₹${Number(middleman).toLocaleString('en-IN')}</td>
            <td class="py-3 px-4 font-mono text-[11px] text-neutral-400 text-right">${timeAgo}</td>
          </tr>
        `;
      }).join('');
    }

    if (sliderPrevBtn) {
      sliderPrevBtn.addEventListener('click', () => {
        if (currentSlideIndex > 0) {
          currentSlideIndex--;
          renderSliderPage();
        }
      });
    }

    if (sliderNextBtn) {
      sliderNextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(databaseRecords.length / ITEMS_PER_SLIDE);
        if (currentSlideIndex < totalPages - 1) {
          currentSlideIndex++;
          renderSliderPage();
        }
      });
    }

    // Initialize Language and Zero State
    applyLanguage(currentLang);
    resetToZero();
    fetchRecentAppraisals();
  });
</script>
